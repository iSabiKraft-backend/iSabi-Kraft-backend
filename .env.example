NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/isabikraft
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
ID_HASH_PEPPER=change-me-too
PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_BASE_URL=https://api.paystack.co
# TRUST_PROXY=1

# --- Onboarding / auth ---
JWT_REMEMBER_EXPIRES_IN=30d          # "Remember me" ticked at login
OTP_TTL_SECONDS=180                  # "Code expires in 02:45" style countdown
OTP_RESEND_COOLDOWN_SECONDS=60       # "Resend available in 00:59"
RESET_TOKEN_TTL_SECONDS=1800
RESET_URL_BASE=http://localhost:3000 # reset links look like <this>/reset-password?token=...
AUTH_RATE_LIMIT=30                   # per IP per 15 min on /api/auth/*
# OTP_PEPPER=                        # optional; defaults to JWT_SECRET
# Email (any SMTP provider)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="iSabiKraft <no-reply@yourdomain.com>"
# SMS (Termii)
# TERMII_API_KEY=
# TERMII_SENDER_ID=iSabiKraft
# Social sign-in: your OAuth client IDs (comma-separate several)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# Local development only: with no email/SMS provider, print codes to the console and
# also return them in the API response so you can test the flow end to end.
# EXPOSE_DEV_OTP=true
# UPLOAD_DIR=uploads

# --- Live selfie verification ---
# PRIVATE_DIR=private                    # where selfie frames are stored (NOT publicly served); use a persistent volume
# SELFIE_SESSION_TTL_SECONDS=300         # time allowed to finish all camera steps
# SELFIE_CHALLENGE_COUNT=3               # random actions per attempt (blink, turn left/right, smile, look up)
# SELFIE_MIN_FRAME_GAP_MS=1000           # frames faster than this are refused
# SELFIE_MAX_SESSIONS_PER_DAY=5
# SELFIE_RETENTION_DAYS=30               # approved frames are deleted after this (rejected ones immediately)
# REQUIRE_SELFIE_FOR_ARTISAN_APPROVAL=true   # admins can't approve an artisan until their selfie is approved
